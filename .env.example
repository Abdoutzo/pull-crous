# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Common
RECIPIENT_EMAIL=your_recipient@example.com

# Local SMTP setup (good for your machine or GitHub manual tests)
EMAIL_PROVIDER=smtp
SENDER_EMAIL=your_sender@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Advanced SMTP override (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Railway/Resend setup (recommended on Railway Hobby/Free because SMTP is blocked)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=alerts@your-verified-domain.com
# RESEND_REPLY_TO=your_sender@gmail.com
# SENDER_EMAIL=your_sender@gmail.com

# Runtime/state (recommended for Railway workers with a mounted volume)
# STATE_FILE=/data/seen_ids.json
# LOG_FILE=/data/crous.log
# ENABLE_FILE_LOGGING=true

# Manual GitHub Actions testing only
# FORCE_EMAIL_WINDOW=false
# REQUIRE_EMAIL_SUCCESS=false
