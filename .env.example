# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Minimal Gmail setup (recommended)
SENDER_EMAIL=your_sender@gmail.com
RECIPIENT_EMAIL=your_recipient@example.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Advanced SMTP override (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Runtime/state (recommended for Railway workers with a mounted volume)
# STATE_FILE=/data/seen_ids.json
# LOG_FILE=/data/crous.log
# ENABLE_FILE_LOGGING=true

# Manual GitHub Actions testing only
# FORCE_EMAIL_WINDOW=false
# REQUIRE_EMAIL_SUCCESS=false
